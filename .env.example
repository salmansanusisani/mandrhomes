# Database
DATABASE_URL="postgresql://user:password@localhost:5432/shopwave?schema=public"

# App — use a long random string (openssl rand -hex 32)
NEXT_PUBLIC_APP_URL="https://mandrhomes.com"
AUTH_SECRET=""
CRON_SECRET=""

# Google OAuth — create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional. Defaults to <current origin>/api/auth/google/callback
GOOGLE_REDIRECT_URI=""

# Paystack — get these from https://dashboard.paystack.com/#/settings/developers
# Leave PAYSTACK_SECRET_KEY empty to enable the mock payment flow (development only).
PAYSTACK_SECRET_KEY=""
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""
PAYSTACK_MOCK="false"

# Email (leave SMTP_HOST empty to log emails to the console)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"
MAIL_FROM="M&R Homes <no-reply@mandrhomes.com>"
SUPPORT_EMAIL="contact@mandrhomes.com"

# Product uploads. Defaults to ./storage/uploads; use a persistent mounted disk in production.
UPLOAD_DIR=""

# Seed credentials
ADMIN_EMAIL="admin@shopwave.test"
ADMIN_PASSWORD="Admin123!"
ADMIN_NAME="Store Admin"
